{
  "name": "yesagencyapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prebuild": "expo prebuild --clean",
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "android": "expo run:android --device",
    "build:dev:android": "npx eas build --profile development-simulator --platform android",
    "build:dev:ios": "npx eas build --profile development-simulator --platform ios",
    "build:dev:last:cli:ios": "npx --yes eas-cli@latest build --profile development-simulator --platform ios",
    "build:dev:last:cli:android": "npx --yes eas-cli@latest build --profile development-simulator --platform android",
    "build:staging": "npx eas build --profile preview --clear-cache",
    "release:staging": "npx eas update --clear-cache --branch preview",
    "submit:ios": "npx eas submit -p ios",
    "submit:android": "npx eas submit -p android",
    "lint": "eslint --fix --ext .js,.ts,.tsx,.jsx .",
    "eject": "expo eject",
    "ts:check": "tsc",
    "build:production": "npx eas build --profile production --clear-cache --auto-submit",
    "release:production": "npx eas update --clear-cache --branch production"
  },
  "dependencies": {
    "@expo/config-plugins": "^54.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.13.2",
    "expo": "~54.0.25",
    "expo-apple-authentication": "^8.0.7",
    "expo-constants": "^18.0.10",
    "expo-device": "^8.0.9",
    "expo-font": "^14.0.9",
    "expo-image-picker": "^17.0.10",
    "expo-linking": "^8.0.9",
    "expo-location": "^19.0.7",
    "expo-splash-screen": "^31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.13",
    "mobx-react-lite": "^4.1.1",
    "moment": "^2.30.1",
    "react": "19.1.0",
    "react-i18next": "^16.3.5",
    "react-native": "0.81.4",
    "react-native-date-picker": "^5.0.13",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-notifier": "^2.0.0",
    "react-native-reanimated": "^4.1.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg-transformer": "^1.5.2",
    "react-native-uuid": "^2.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.7",
    "eslint-plugin-react": "^7.37.5",
    "expo-build-properties": "^1.0.9",
    "expo-dev-client": "~6.0.20",
    "typescript": "~5.9.2"
  },
  "private": true
}
